# 魔法学习王国 — 环境变量示例
# 复制为 .env.local（开发）；生产用 PM2 env 或系统环境注入。
# 真实密钥不要提交。Prisma 读 .env，Next.js 读 .env.local。

# ── 数据库 ────────────────────────────────────────────
# PostgreSQL（schema.prisma provider 已是 postgresql）
# 本地：连 docker-compose 的 db 容器（5432 已映射宿主机）
DATABASE_URL="postgresql://mlk:mlk_dev_pw@localhost:5432/mlk?schema=public"
# 容器内 web 服务用 compose 注入的 db:5432（见 docker-compose.yml），不读本文件
# 早期 SQLite（已弃用）：DATABASE_URL="file:./dev.db"

# ── NextAuth v5 ──────────────────────────────────────
# 生成：openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── 应用 ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI 精灵（全部可选；都不填则走 mock）─────────────────
# 大陆直连、低成本，面向孩子的实时对话首选
# DEEPSEEK_API_KEY="sk-..."
# 海外市场 / 无 DeepSeek 时回退
# ANTHROPIC_API_KEY="sk-ant-..."
# Claude 经海外中转（如 Cloudflare Worker）时填中转 baseURL；留空走官方直连
# ANTHROPIC_BASE_URL="https://your-relay.example.com"
# 小精灵查询附近地点、营业时间、票价等实时网页信息
# TAVILY_API_KEY="tvly-..."

# ── 语音底座（腾讯云 ASR+TTS，#4；可选，缺失则回退 Web Speech）──
# 建议用仅含语音权限的 CAM 子账号密钥
# TENCENT_SECRETID="AKID..."
# TENCENT_SECRETKEY="..."

# ── 阿里云盘知识影院（可选；配置后启用 /theater）──────────────
# 在阿里云盘开放平台创建应用并完成一次 OAuth，服务端只保存 refresh_token
# ALIYUN_APP_ID="your-app-id"
# ALIYUN_APP_SECRET="your-app-secret"
# ALIYUN_REFRESH_TOKEN="your-refresh-token"
# ALIYUN_VIDEO_FOLDER_ID="folder-file-id"
# 可选；不填时从 token/driveInfo 推断
# ALIYUN_DRIVE_ID="drive-id"
