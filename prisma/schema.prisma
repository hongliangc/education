// 魔法学习王国 — Prisma Schema
// 数据库：PostgreSQL（2026-05-30 全栈容器化后由 SQLite 切换）。
// 容器栈见 docker-compose.yml；本地开发也连容器里的 Postgres（5432 已映射宿主机）。
// 注：沿用 String + 应用层校验代替 enum（SQLite 时期约定，PG 同样适用）。

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String             @id @default(cuid())
  phone                String?            @unique
  email                String?            @unique
  passwordHash         String?
  role                 String             @default("PARENT") // PARENT | CHILD | ADMIN
  children             Child[]
  subscription         Subscription?
  rewardResources      RewardResource[]   @relation("RewardResourceOwner")
  fulfilledRedemptions RewardRedemption[] @relation("RewardRedemptionFulfiller")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Child {
  id              String             @id @default(cuid())
  parentId        String
  parent          User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name            String
  age             Int
  gradeLevel      String?
  avatar          String             @default("🌸")
  fairyLevel      Int                @default(1)
  totalStars      Int                @default(0)
  hearts          Int                @default(3)
  streakDays      Int                @default(0)
  lastLoginDate   DateTime?
  progress        LearningProgress[]
  lessonProgress  LessonProgress[]
  sessions        GameSession[]
  achievements    Achievement[]
  weeklyReports   WeeklyReport[]
  fairyDialogs    FairyDialogue[]
  readingProgress ReadingProgress[]
  videoUnlocks    VideoUnlock[]
  redemptions     RewardRedemption[]
  starLedger      StarLedger[]
  createdAt       DateTime           @default(now())

  @@index([parentId])
}

model LearningProgress {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  module      String // WRITING | ALPHABET | WORDS | MATH | STORY | LIFE
  gradeLevel  String    @default("LEGACY") // K1-G3；LEGACY 为分级前的汇总记录
  level       Int       @default(1)
  stars       Int       @default(0)
  masteryPct  Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([childId, module, gradeLevel])
}

// Per-lesson progress for the guided curriculum (a module's grade is an ordered lesson path).
// Distinct from LearningProgress, which tracks module-level mastery per grade.
model LessonProgress {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  module      String // MATH | WORDS | ALPHABET ...
  grade       String // K1-G3
  lessonKey   String // 如 g1-add-within-20
  stars       Int       @default(0) // 该节最好成绩
  masteryPct  Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([childId, module, grade, lessonKey])
  @@index([childId])
}

model GameSession {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  module      String
  gradeLevel  String   @default("LEGACY") // K1-G3；LEGACY 为分级前的会话
  score       Int
  totalQ      Int
  correctQ    Int
  durationSec Int
  starsEarned Int
  createdAt   DateTime @default(now())

  @@index([childId, createdAt])
}

model FairyDialogue {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  userMsg   String
  aiReply   String
  context   String?
  createdAt DateTime @default(now())

  @@index([childId, createdAt])
}

model WeeklyReport {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  summaryJson String // JSON 字符串（SQLite 无 Json 原生类型）
  aiAdvice    String
  createdAt   DateTime @default(now())

  @@index([childId, weekStart])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("FREE") // FREE | MONTHLY | YEARLY | OVERSEAS
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  status    String    @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
}

model Achievement {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badge    String
  earnedAt DateTime @default(now())

  @@index([childId])
}

model ReadingProgress {
  id                String   @id @default(cuid())
  childId           String
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  bookId            String // StoryBook.id（内容层常量，非外键）
  lastChapterIdx    Int      @default(0) // 续读书签：最近阅读到的章节
  completedChapters Int      @default(0) // 已通关章节数（顺序解锁依据）
  finished          Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@unique([childId, bookId])
  @@index([childId])
}

model VideoUnlock {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  videoId    String
  starsCost  Int
  unlockedAt DateTime @default(now())

  @@unique([childId, videoId])
  @@index([childId])
}

model RewardResource {
  id           String             @id @default(cuid())
  ownerType    String // PLATFORM | FAMILY
  ownerId      String? // FAMILY 时为 User.id；PLATFORM 时为 null
  owner        User?              @relation("RewardResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  scopeKey     String // 必须通过 makeResourceScopeKey 生成；PLATFORM 或 FAMILY:<parentId>
  resourceType String // STORY_CHAPTER | STORY_TALE | VIDEO | REWARD
  resourceKey  String // bookId:chapterIdx / bookId / stable videoId / reward key
  title        String
  description  String?
  imageUrl     String?
  starsCost    Int                @default(0)
  stock        Int? // null=不限库存
  isActive     Boolean            @default(true)
  sortOrder    Int                @default(0)
  redemptions  RewardRedemption[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // 保留批准模型形状；PG 允许 NULL 重复，不能用此约束保证平台资源唯一。
  @@unique([ownerType, ownerId, resourceType, resourceKey])
  // RewardResource 创建和 upsert 必须使用 makeResourceScopeKey 生成 scopeKey，并使用此唯一键。
  @@unique([scopeKey, resourceType, resourceKey])
  @@index([ownerType, ownerId, resourceType, isActive])
}

model RewardRedemption {
  id            String         @id @default(cuid())
  childId       String
  child         Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      RewardResource @relation(fields: [resourceId], references: [id])
  quantity      Int            @default(1)
  starsSpent    Int
  status        String // COMPLETED | PENDING_FULFILLMENT | FULFILLED | REJECTED_REFUNDED
  unlockKey     String?        @unique
  fulfilledAt   DateTime?
  fulfilledById String?
  fulfilledBy   User?          @relation("RewardRedemptionFulfiller", fields: [fulfilledById], references: [id])
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([childId, createdAt])
  @@index([status, createdAt])
}

model StarLedger {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       String // SESSION_EARN | REDEMPTION | REFUND | OPENING_BALANCE | ADMIN_ADJUST
  referenceId  String?
  dedupeKey    String?  @unique
  createdAt    DateTime @default(now())

  @@index([childId, createdAt])
}
